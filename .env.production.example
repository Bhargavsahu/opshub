# ─── Database (Neon for prod) ─────────────────────────────────
# Pooled connection (for app queries)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/opshub?sslmode=require"
# Direct connection (for migrations)
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/opshub?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT secrets — generate with: npm run generate-secrets
JWT_ACCESS_SECRET="change-me-run-generate-secrets"
JWT_REFRESH_SECRET="change-me-run-generate-secrets"

# ─── AI ───────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV="production"
FRONTEND_URL="https://your-subdomain.yourdomain.com"
DOMAIN="your-subdomain.yourdomain.com"
