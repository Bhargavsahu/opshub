# ─── Database (Docker Postgres for dev) ───────────────────────
DATABASE_URL="postgresql://opshub:opshub_dev@localhost:5432/opshub_dev"
DIRECT_URL="postgresql://opshub:opshub_dev@localhost:5432/opshub_dev"

# ─── Auth ─────────────────────────────────────────────────────
# Google OAuth Client ID (create at console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT secrets — generate with: npm run generate-secrets
JWT_ACCESS_SECRET="change-me-run-generate-secrets"
JWT_REFRESH_SECRET="change-me-run-generate-secrets"

# ─── AI ───────────────────────────────────────────────────────
# Gemini API key (get from aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
